{
  "expo": {
    "name": "Udub Mart",
    "slug": "udub-mart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "udubmart",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "so.udub.mart",
      "supportsTablet": false
    },
    "android": {
      "package": "so.udub.mart",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Udub Mart uses your location to set the delivery point of your address."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0C6060"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E494B",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://e.udub.so/api/mobile",
      "google": {
        "iosClientId": "",
        "androidClientId": "",
        "webClientId": ""
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b3a7c91d-adf8-423e-b9ae-fe29e66d360c"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "udub-group",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3a7c91d-adf8-423e-b9ae-fe29e66d360c"
    }
  }
}
